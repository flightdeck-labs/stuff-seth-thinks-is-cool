---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Stuff Seth Thinks Is Cool',
  description = 'Selected software-development links curated by Seth and Goose.'
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="alternate" type="application/rss+xml" title="RSS" href={`${base}rss.xml`} />
    <style is:global>
      :root { color-scheme: light dark; --bg: #f8f5ef; --fg: #1d2733; --muted: #5c6875; --card: #fff; --line: #d8d1c6; --accent: #0f5c8f; }
      @media (prefers-color-scheme: dark) { :root { --bg: #111820; --fg: #f4efe7; --muted: #b2bfca; --card: #18222d; --line: #2d3a47; --accent: #7cc7ff; } }
      body { margin: 0; font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: var(--bg); color: var(--fg); line-height: 1.6; }
      a { color: var(--accent); }
      .site-shell { width: min(920px, calc(100% - 32px)); margin: 0 auto; }
      header.site-header { padding: 36px 0 20px; border-bottom: 1px solid var(--line); margin-bottom: 28px; }
      .nav { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 12px; }
      .nav a { font-weight: 700; text-decoration: none; }
      h1, h2, h3 { line-height: 1.15; }
      h1 { font-size: clamp(2rem, 8vw, 4rem); margin: 0; letter-spacing: -0.05em; }
      .lede { color: var(--muted); font-size: 1.15rem; max-width: 62ch; }
      footer { color: var(--muted); border-top: 1px solid var(--line); margin-top: 42px; padding: 22px 0 38px; }
    </style>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <h1><a href={base} style="color: inherit; text-decoration: none;">Stuff Seth Thinks Is Cool</a></h1>
        <p class="lede">Selected software-development links Seth saves, with Goose preparing concise notes for review.</p>
        <nav class="nav" aria-label="Primary navigation">
          <a href={base}>Home</a>
          <a href={`${base}about/`}>About</a>
          <a href={`${base}rss.xml`}>RSS</a>
        </nav>
      </header>
      <main><slot /></main>
      <footer><p>Links belong to their original authors. Publication happens through pull-request review.</p></footer>
    </div>
  </body>
</html>
