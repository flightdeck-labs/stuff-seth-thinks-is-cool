---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkCard from '../components/LinkCard.astro';

const links = (await getCollection('links')).sort((a, b) => new Date(b.data.proposed_at).getTime() - new Date(a.data.proposed_at).getTime());
---
<BaseLayout title="Stuff Seth Thinks Is Cool">
  <section aria-labelledby="latest-links">
    <div class="section-heading">
      <h2 id="latest-links">Latest links</h2>
      <p class="section-kicker">Carrier deck queue</p>
    </div>
    {links.length === 0 ? <p>No links yet.</p> : links.map((link) => <LinkCard link={link} />)}
  </section>
</BaseLayout>
